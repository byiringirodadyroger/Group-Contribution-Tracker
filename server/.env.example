NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/group_contribution_tracker
# Generate each secret independently with a cryptographically secure generator.
JWT_SECRET=
BOOTSTRAP_SETUP_SECRET=
# Comma-separated exact frontend origins, with scheme and port as applicable.
CORS_ORIGINS=http://localhost:5173
# Gmail SMTP example; use a Google App Password, never your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Defaults to the Render service URL or first CORS origin when unset.
PUBLIC_APP_URL=
# Optional: restrict inbound access to trusted IPs (comma-separated or newline-separated).
# Leave unset to allow all client IPs during local development.
ALLOWED_IPS=
# Use none + true when frontend and API are on different sites.
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
COOKIE_DOMAIN=
JWT_EXPIRES_IN=12h
# Optional CSV override for the five regular member names. Must not contain Roger.
REGULAR_MEMBER_NAMES=Jean Bosco,Ildebrand,Vivant,Shema,Renne Shaffy
